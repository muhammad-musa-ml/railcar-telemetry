      "observability/prometheus/rules/railcar.rules.yml": "e1d1f235e12e141218af4d1244c8f7cc5ec1e19fd004bd9a3bec56ecc7f25503",
      "observability/prometheus/prometheus.yml": "39d8b698493346036ebd4a39391a87fbf418178929e976a485c5bae72950791e",
      "observability/alertmanager/alertmanager.yml": "9ee4a1f4392ed3bc8f1ae86aebfa3dd514adcf62f445b71a33368add4a1e4ab1",
      "src/tracker/tracker.ts": "76c5bda80c1f2cd3de2e1086867042b6b29e16a49fb4ee3bf3fb189a9a545f51",
      "src/ingest/stream-stats.ts": "34fd318ef887a697649e330f302fcf37d9edc9858389d40eef27f456a956fbc0"
    },
    "tracker_image": "sha256:401b6a0cb7f4614c312d80f7b5bb2390501bb650b4d4808140abda4658aacf44",
    "ingest_image": "sha256:2d5c93bc1ef01c49ff479243489d56476b4318a03ec17dbf8e995190fa98992d",
    "loaded_alert_rules": [
      {
        "name": "IngestErrorRateHigh",
        "for_seconds": 120,
        "query": "sum(rate(http_server_requests_total{job=\"ingest\",route=\"/v1/events\",status_code=~\"5..\"}[1m])) / sum(rate(http_server_requests_total{job=\"ingest\",route=\"/v1/events\"}[1m])) > 0.05"
      },
      {
        "name": "QueryErrorRateHigh",
        "for_seconds": 120,
        "query": "sum(rate(http_server_requests_total{job=\"query\",route=~\"/v1/.*\",status_code=~\"5..\"}[1m])) / sum(rate(http_server_requests_total{job=\"query\",route=~\"/v1/.*\"}[1m])) > 0.05"
      },
      {
        "name": "QueryLatencyHigh",
        "for_seconds": 600,
        "query": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"query\",route=~\"/v1/.*\"}[5m]))) > 0.5"
      },
      {
        "name": "ServiceDown",
        "for_seconds": 300,
        "query": "up{job=~\"ingest|tracker|query\"} == 0"
      },
      {
        "name": "RailcarEventsDelayed",
        "for_seconds": 60,
        "query": "max(railcar_stream_oldest_unacked_age_seconds{group=\"tracker\"}) > 60"
      },
      {
        "name": "RailcarPositionsStale",
        "for_seconds": 300,
        "query": "max(railcar_positions_freshness_seconds) > 300"
      },
      {
        "name": "StreamBacklogHigh",
        "for_seconds": 600,
        "query": "sum(railcar_stream_group_lag{group=\"tracker\"}) + sum(railcar_stream_group_pending{group=\"tracker\"}) > 5000"
      },
      {
        "name": "TrackerProcessingErrors",
        "for_seconds": 120,
        "query": "sum(rate(tracker_events_failed_total[1m])) > 0"
      },
      {
        "name": "DeadLetteredEvents",
        "for_seconds": 0,
        "query": "sum(increase(tracker_events_dead_lettered_total[15m])) > 0"
      }
    ],
    "toxics_after": []
  }
}
